# Copy to .env and fill in what you need. NEVER commit .env.

# true  = generate everything but NEVER upload to YouTube (safe testing)
# false = allow uploads
TEST_MODE=true

# --- Script writer (all free). Leave empty to use the built-in offline templates. ---
# LLM_PROVIDER: auto | gemini | groq | ollama | template
LLM_PROVIDER=auto
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Local & free: https://ollama.com  (then: ollama pull llama3.2)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Free stock photos (optional) ---
# https://www.pexels.com/api/   https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Voice: auto | edge | pyttsx3 | espeak ---
TTS_ENGINE=auto

# --- YouTube (OAuth). Path to the JSON downloaded from Google Cloud Console ---
YOUTUBE_CLIENT_SECRETS=data/client_secret.json
OAUTH_PORT=8765

# --- Server ---
HOST=127.0.0.1
PORT=8000
